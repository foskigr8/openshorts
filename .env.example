# AWS S3 (optional — for clip backup/gallery)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=eu-west-3
AWS_S3_BUCKET=your-bucket-name
AWS_S3_PUBLIC_BUCKET=your-public-bucket-name

# YouTube cookies (optional — paste Netscape-format cookies to bypass bot detection)
# YOUTUBE_COOKIES=...

# Google OAuth (cloud/billing mode only). When logging in through a proxy whose
# Host header doesn't match a Google-registered URI (e.g. local dev via the Vite
# proxy), pin the callback explicitly:
# OAUTH_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# FRONTEND_URL=http://localhost:5175

# Local dev: show the full pipeline logs (yt-dlp/ffmpeg/debug) in the UI even
# when running in paid mode (BILLING_ENABLED). Cloud/prod leaves this unset.
# DEBUG_LOGS=true

# Pre-flight quality gate: warn before processing a YouTube source below this
# height (720p default; 0 disables). Only applies to URL sources.
# QUALITY_GATE_MIN_HEIGHT=720

# Whisper transcription model (main pipeline). "small" is better than "base" on
# non-English audio; "base" is faster. device/compute for GPU tuning.
# Prod GPU: WHISPER_MODEL=large-v3-turbo WHISPER_DEVICE=cuda WHISPER_COMPUTE=float16
# WHISPER_MODEL=small
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE=int8

# Transcription backend: whisper (default) | parakeet | assemblyai. Parakeet
# (NVIDIA parakeet-tdt-0.6b-v3 via onnx-asr, GPU image only) is ~2x faster
# than whisper-turbo-GPU. assemblyai calls AssemblyAI's cloud API (needs
# ASSEMBLYAI_API_KEY below, or a key set in the dashboard's Settings page)
# and enables speaker-label + sentiment-analysis segmentation for the
# narrative clip-selection stage. All backends auto-fall-back to whisper on
# errors, timeouts, or (for parakeet) languages outside its 25 European ones.
# TRANSCRIBE_BACKEND=whisper

# Concurrent GPU transcriptions (parakeet or whisper-on-cuda). Keep 1.
# ASR_GPU_CONCURRENCY=1

# AssemblyAI (optional) — transcription backend, see TRANSCRIBE_BACKEND above.
# Can also be set per-request from the dashboard's Settings page (BYOK), which
# takes precedence over this server-side value.
# ASSEMBLYAI_API_KEY=...

# DeepSeek (optional) — narrative-arc-aware clip selection, replacing Gemini's
# text-based scoring pass when set (Gemini Vision still confirms candidates).
# Can also be set from Settings (BYOK), which takes precedence.
# DEEPSEEK_API_KEY=...
# DeepSeek V4 Flash is the default narrative editor. Set this explicitly
# only if you need to override it (e.g. deepseek-v4-pro).
# DEEPSEEK_MODEL=deepseek-v4-flash

# --- Stage 3: which engine picks the clips ---------------------------------
# auto (default) runs the viral-clip-finder skill engine and falls back to the
# narrative engine if it fails; skill makes it a hard requirement (a failure
# fails the job instead of quietly degrading); narrative restores the older
# behaviour exactly.
# VIRAL_ENGINE=auto
# Which of the skill's reference docs to load. Full (default) is ~124KB of
# methodology prepended to every Stage 3 call — that breadth IS the quality.
# "lean" keeps only the scoring rubric and anti-patterns (~-69KB) when cost or
# latency matters more; a comma-separated list picks exact files.
# VCF_REFERENCES=full
# Allow DeepSeek's own API as a Stage 3 provider (default: Gemini only).
# VCF_ALLOW_DEEPSEEK=0
#
# The narrative engine's Gemini key. Deliberately SEPARATE from GEMINI_API_KEY
# so Stage 3 doesn't compound quota pressure on the vision/scene-context calls.
# Note it has no fallback: unset, the narrative engine has no provider at all
# and cannot act as the "auto" safety net. The skill engine does fall back to
# GEMINI_API_KEY, so it keeps working either way.
# NARRATIVE_GEMINI_API_KEY=...

# --- Optional: named speakers (face ID) ------------------------------------
# Point at a folder of {person_name}.jpg headshots to turn anonymous diarized
# labels ("SPEAKER_00") into names before Stage 3 reads the transcript, so cut
# briefs can reference people by name. Needs `pip install insightface
# onnxruntime-gpu`; fails open (anonymous speakers) if anything is missing.
# FACE_ID_DB=/path/to/known_faces
# Cap the scan — ArcFace over a full 2-hour stream costs GPU-minutes before
# Stage 3 even starts, and identity is established in the first few minutes.
# FACE_ID_MAX_SECONDS=900

# Video encoder for all ffmpeg encodes: x264 (default) | nvenc | auto.
# auto probes h264_nvenc once at startup and falls back to x264 if unusable.
# FFMPEG_ENCODER=x264

# Product analytics (optional, off by default). Both are read by the dashboard
# at BUILD time. Leave them unset and the frontend initialises no analytics and
# loads no third-party script. Set them to your own OpenPanel instance — and add
# your hostname to ANALYTICS_HOSTS in dashboard/index.html — to collect your own.
# VITE_OPENPANEL_API_URL=https://api.openpanel.example.com
# VITE_OPENPANEL_CLIENT_ID=your_openpanel_client_id
